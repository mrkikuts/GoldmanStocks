# Copy to .env and fill in from the Supabase dashboard (Project Settings → API).
# Public (VITE_ prefix = injected into the client bundle by vite.config.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — NEVER prefix these with VITE_ (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Track B (B4) — server only
ANTHROPIC_API_KEY=

# Demo boss account — created by `bun run seed`, used for the app's auto-login (A5).
# Server only: these never reach the browser bundle.
DEMO_BOSS_EMAIL=boss@rootline.demo
DEMO_BOSS_PASSWORD=
